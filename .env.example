# Klíče pro generování grafiky. Zkopírujte tenhle soubor jako `.env`
# a vyplňte. `.env` je v .gitignore, do repozitáře se nedostane.
#
# Klíče potřebují jen skripty v scripts/ — samotný web ani jeho nasazení
# na GitHub Pages je nepoužívají.

# Obrázky — https://www.recraft.ai/ → API
RECRAFT_API_TOKEN=

# Video (image-to-video) — https://fal.ai/dashboard/keys
FAL_KEY=
