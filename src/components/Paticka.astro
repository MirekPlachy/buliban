---
const zaklad = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer
  id="kontakt"
  class="border-t border-white/5 bg-noc-900 px-6 py-16 text-center"
>
  <p class="font-display text-2xl text-plamen-400">Buliban</p>

  <ul class="mt-6 flex flex-wrap justify-center gap-6 text-sm text-uhel-300/60">
    <li>
      <a
        href={`${zaklad}/vystrely/`}
        class="transition hover:text-plamen-400 focus-visible:ring-2 focus-visible:ring-plamen-400 focus-visible:outline-none"
        >Výstřely</a
      >
    </li>
    <li>
      <a
        href={`${zaklad}/minihra/`}
        class="transition hover:text-plamen-400 focus-visible:ring-2 focus-visible:ring-plamen-400 focus-visible:outline-none"
        >Minihra</a
      >
    </li>
  </ul>

  <p class="mt-8 text-sm text-uhel-300/50">
    &copy; {new Date().getFullYear()} — recesistická prezentace. Žádní Bulibani
    nebyli při výrobě tohoto webu zraněni.
  </p>
</footer>
