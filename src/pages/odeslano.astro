---
/**
 * Potvrzení po odeslání kontaktního formuláře. Web3Forms sem návštěvníka
 * pošle podle skrytého pole `redirect` (PLAN.md, fáze 3, krok 9).
 */
import Base from '../layouts/Base.astro';
import Plamen from '../components/Plamen.astro';

const title = 'Zpráva odešla — Buliban';
const description = 'Zpráva dorazila. Ozveme se, jakmile plamen dohoří.';

const zaklad = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={title} description={description}>
  <section class="relative overflow-hidden px-6 pt-36 pb-28">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="dychani absolute -top-24 left-1/2 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-plamen-500/15 blur-[130px]"
      >
      </div>
    </div>

    <div class="relative z-10 mx-auto max-w-2xl text-center">
      <Plamen trida="mx-auto mb-6 opacity-70" />

      <p class="mb-5 text-xs tracking-[0.4em] text-kour-400 uppercase">
        Odesláno
      </p>

      <h1 class="font-display text-4xl text-uhel-100 sm:text-5xl">
        Zpráva dorazila
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-uhel-300/75">
        Děkujeme. Čteme všechno a odpovídáme, jakmile se dostaneme od láhve
        ke klávesnici.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href={`${zaklad}/`}
          class="rounded-full border border-plamen-400/40 bg-plamen-400/10 px-8 py-3.5 text-sm font-medium tracking-wide text-plamen-400 transition hover:border-plamen-400 hover:bg-plamen-400/20 focus-visible:ring-2 focus-visible:ring-plamen-400 focus-visible:outline-none"
          >Zpátky na web</a
        >
        <a
          href={`${zaklad}/zazehy/`}
          class="rounded-full border border-white/10 px-8 py-3.5 text-sm font-medium tracking-wide text-uhel-300 transition hover:border-kour-400/50 hover:text-kour-400 focus-visible:ring-2 focus-visible:ring-kour-400 focus-visible:outline-none"
          >Kronika zážehů</a
        >
      </div>
    </div>
  </section>
</Base>
