---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Video from '../components/Video.astro';
import obrazekNauka from '../assets/generovane/nauka.webp';

const title = 'Buliban — zkroť svůj plamen';
const description =
  'Buliban je tradice, která se rodila v mlžných údolích dávných hor. Objev buliban v sobě.';

const zaklad = import.meta.env.BASE_URL.replace(/\/$/, '');

// Sekce, které teprve čekají na obsah. Kotvy odpovídají mapě v PLAN.md,
// protože z ní vychází i přesměrování starých URL.
const pripravene = [
  { id: 'historie', nazev: 'Historie Bulibanu' },
  { id: 'zahrivani', nazev: 'Způsoby zahřívání' },
  { id: 'vertikalni-horizontalni', nazev: 'Vertikální versus horizontální' },
  { id: 'jak-vypustit', nazev: 'Jak vypustit Bulibana?' },
  { id: 'opakovane-zapaleni', nazev: 'Opakované zapálení' },
  { id: 'dnes', nazev: 'Buliban dnes' },
];
---

<Base title={title} description={description}>
  <!-- ========================= HERO ========================= -->
  <section
    class="relative flex min-h-dvh items-center justify-center overflow-hidden px-6 text-center"
  >
    <!-- Podkladová smyčka. Dokud video není hotové, drží místo plamen. -->
    <div class="absolute inset-0" aria-hidden="true">
      <Video
        poster="/video/hero.jpg"
        popis="Plamen hořící ve tmě"
        trida="opacity-40"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-noc-950/70 via-noc-950/40 to-noc-950"
      >
      </div>
    </div>

    <!-- světelné mlhy v pozadí -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="dychani absolute top-1/4 left-1/2 h-[38rem] w-[38rem] -translate-x-1/2 rounded-full bg-plamen-500/25 blur-[120px]"
      >
      </div>
      <div
        class="dychani absolute bottom-0 left-[15%] h-[26rem] w-[26rem] rounded-full bg-jiskra-400/20 blur-[110px]"
        style="animation-delay: -2.5s"
      >
      </div>
      <div
        class="dychani absolute top-[10%] right-[10%] h-[22rem] w-[22rem] rounded-full bg-kour-400/15 blur-[100px]"
        style="animation-delay: -5s"
      >
      </div>
    </div>

    <div class="relative z-10 mx-auto max-w-3xl">
      <p
        class="mb-8 text-xs tracking-[0.45em] text-plamen-400/80 uppercase sm:text-sm"
      >
        Za hranicemi běžného rituálu
      </p>

      <h1
        class="font-display text-6xl leading-[0.95] font-bold tracking-tight text-transparent sm:text-8xl lg:text-9xl"
        style="background-image: linear-gradient(160deg, #fff6e6 10%, #ffb347 45%, #ff5fa2 100%); -webkit-background-clip: text; background-clip: text;"
      >
        BULIBAN
      </h1>

      <p class="mx-auto mt-10 max-w-xl text-lg text-uhel-300/85 sm:text-xl">
        Tradice, která se rodila v mlžných údolích dávných hor — a dnes hoří
        dál. <span class="text-plamen-400">Zkroť svůj plamen.</span>
      </p>

      <div class="mt-12 flex flex-wrap justify-center gap-4">
        <a
          href="#nauka"
          class="rounded-full border border-plamen-400/40 bg-plamen-400/10 px-8 py-3.5 text-sm font-medium tracking-wide text-plamen-400 transition hover:border-plamen-400 hover:bg-plamen-400/20 focus-visible:ring-2 focus-visible:ring-plamen-400 focus-visible:outline-none"
        >
          Objev buliban v sobě
        </a>
        <a
          href={`${zaklad}/vystrely/`}
          class="rounded-full border border-white/12 px-8 py-3.5 text-sm font-medium tracking-wide text-uhel-300/80 transition hover:border-jiskra-400/50 hover:text-jiskra-400 focus-visible:ring-2 focus-visible:ring-jiskra-400 focus-visible:outline-none"
        >
          Prohlédnout výstřely
        </a>
      </div>
    </div>

    <div
      class="absolute bottom-10 left-1/2 -translate-x-1/2 text-uhel-300/40"
      aria-hidden="true"
    >
      <svg width="22" height="34" viewBox="0 0 22 34" fill="none">
        <rect
          x="1"
          y="1"
          width="20"
          height="32"
          rx="10"
          stroke="currentColor"
          stroke-width="1.5"></rect>
        <circle cx="11" cy="10" r="2.5" fill="currentColor">
          <animate
            attributeName="cy"
            values="10;22;10"
            dur="2.4s"
            repeatCount="indefinite"></animate>
        </circle>
      </svg>
    </div>
  </section>

  <!-- ========================= NAUKA ========================= -->
  <section id="nauka" class="border-t border-white/5 bg-noc-900 px-6 py-32">
    <div class="mx-auto grid max-w-5xl items-center gap-14 md:grid-cols-[1fr_auto]">
      <div class="reveal">
        <p class="mb-5 text-xs tracking-[0.35em] text-kour-400 uppercase">
          Kapitola první
        </p>
        <h2
          class="font-display text-4xl leading-tight font-semibold text-white sm:text-5xl"
        >
          Co je to Buliban?
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-uhel-300/80">
          Rituál, který propojuje generace. Spojuje tradiční prvky s technologií
          a kreativitou, klade důraz na bezpečnost, kvalitu zážitku a estetiku.
        </p>
        <p class="mt-5 text-lg leading-relaxed text-uhel-300/60">
          <em
            >Zástupný text — sem přijde skutečný obsah ve fázi 2 podle
            PLAN.md.</em
          >
        </p>
      </div>

      <div class="reveal">
        <Image
          src={obrazekNauka}
          alt="Plamen hořící v temné kovárně"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 40vw"
          class="rounded-3xl border border-white/8 shadow-2xl shadow-black/50"
        />
      </div>
    </div>
  </section>

  <!-- ========================= PŘIPRAVENÉ SEKCE ========================= -->
  <section class="bg-noc-950 px-6 py-32">
    <div class="mx-auto max-w-5xl">
      <div class="reveal">
        <p class="mb-5 text-xs tracking-[0.35em] text-jiskra-400 uppercase">
          Co bude následovat
        </p>
        <h2 class="font-display text-4xl font-semibold text-white sm:text-5xl">
          Sekce připravené k naplnění
        </h2>
      </div>

      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          pripravene.map(({ id, nazev }, i) => (
            <li
              id={id}
              class="reveal scroll-mt-24 rounded-2xl border border-white/8 bg-white/[0.03] p-7 transition hover:border-plamen-400/30 hover:bg-white/[0.05]"
              style={`transition-delay: ${i * 70}ms`}
            >
              <span class="font-display text-3xl text-plamen-400/30">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-display text-xl text-white">{nazev}</h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
