---
/**
 * Minihra „Vypusť Bulibana!" — celý rituál ve třech fázích.
 *
 * Stránka je schválně holá: žádná navigace ani patička, protože hra běží
 * přes celou výšku okna a jakýkoli okraj by na mobilu ubral z hrací plochy.
 * Odkaz zpět na web drží samotná hra až v závěrečné obrazovce.
 */
import '../styles/global.css';

const title = 'Vypusť Bulibana! — minihra';
const description =
  'Otevři láhev, rozlij ji mezi panáky a z prázdné vypusť Bulibana. Do panáku se lije jednou a dolít se nedá.';
const zaklad = import.meta.env.BASE_URL.replace(/\/$/, '');
const kanonicka = new URL(Astro.url.pathname, Astro.site);
const jeOstra = new URL(Astro.site!).hostname === 'buliban.cz';
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={kanonicka} />
    <link rel="icon" href={`${zaklad}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#1a0f0a" />
    {!jeOstra && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${zaklad}/og.jpg`, Astro.site)} />
  </head>

  <body class="bg-hra-sklo">
    <main class="flex h-dvh w-full flex-col">
      <!-- `touch-action: none` je podmínka hratelnosti na mobilu, ne kosmetika:
           bez toho si prohlížeč vyloží držení prstu jako scroll a nalévání
           se v půlce přeruší. -->
      <canvas
        id="hra"
        class="h-full w-full touch-none select-none"
        aria-label="Rituál Buliban ve třech krocích: otevření láhve, rozlévání rumu do panáků a zapálení prázdné láhve. Ovládá se držením nebo ťukáním levého tlačítka, prstu či mezerníku; volby se vybírají kliknutím nebo číslicemi."
      ></canvas>
    </main>

    <noscript>
      <p class="p-8 text-center text-hra-par">
        Hra potřebuje JavaScript. Bez něj se nalévat nedá.
      </p>
    </noscript>

    <script>
      import { pripoj } from '../hra/index.ts';

      const platno = document.getElementById('hra');
      if (platno instanceof HTMLCanvasElement) pripoj(platno);
    </script>
  </body>
</html>
