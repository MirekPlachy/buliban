# build výstup
dist/
.astro/

# závislosti
node_modules/

# logy
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# prostředí — API klíče. Repozitář je veřejný, takže tohle je to
# nejdůležitější pravidlo v celém souboru. Ignoruje se všechno, co začíná
# na .env, kromě vzoru s prázdnými hodnotami.
.env
.env.*
!.env.example

# ať se klíč neschová ani pod domácký název
klice.txt
klice.json
secrets.*

# editory a OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# dočasné soubory
_to_delete/

# zálohy grafiky před přegenerováním — místní pojistka, do repozitáře nepatří
# (staré verze obrázků drží i historie gitu)
zaloha/

# neposouzení kandidáti z `npm run kandidati`; do repozitáře jde až vítěz
kandidati/

# kandidáti na vzory jsou jednorázoví; vybrané vzory o složku výš se commitují
grafika/reference/kandidati/
